HOST_PORT=8080
PORT=8080
TICK_RATE=20
MAX_PLAYERS=8
DATA_DIR=/app/data

# Địa chỉ hiển thị trong phòng để mời người thân, ví dụ http://192.168.1.10:8080
PUBLIC_URL=
GRACE_MS=60000
MAX_ROOMS=50

# Optional AI referee (ai-app-kernel) — provider/model are auto-selected by default
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# Local AI examples (no cloud token required)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
# Optional: require this PIN to set/clear the AI token from the game UI (recommended on shared Wi-Fi)
# AI_ADMIN_PIN=
