# Internal container port. Do NOT set a public/host port here: SoloHost Port Manager (or Docker) assigns it.
PORT=8080
TICK_RATE=20
MAX_PLAYERS=8
DATA_DIR=/app/data

# Optional override of the invite address shown in rooms. Leave empty: it follows the address/port the browser used.
PUBLIC_URL=
GRACE_MS=60000
MAX_ROOMS=50

# Optional AI referee (ai-app-kernel) — provider/model are auto-selected by default
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# Local AI examples (no cloud token required)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
# Optional: require this PIN to set/clear the AI token from the game UI (recommended on shared Wi-Fi)
# AI_ADMIN_PIN=

# SoloHost Feedback Hub: hub address, ingest token and app id are BUILT INTO the code (server.js) - nothing to declare.
# Optional overrides only:
# SHFH_HUB_URL=http://14.176.78.46:8090
# SHFH_INGEST_TOKEN=
# SHFH_APP_ID=snake-arcade
# SHFH_ENABLED=1
